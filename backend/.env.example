# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database (MongoDB Atlas free tier — 512MB, always free) ----
MONGO_URI=your_mongodb_connection_string

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- AI Provider (which adapter services/ai/index.js uses by default) ----
# one of: gemini | groq | openrouter
AI_PROVIDER=gemini

# Gemini — free tier via Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Groq — free tier, very fast inference (console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — free-tier models available, e.g. models with ":free" suffix
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ---- Vector store: ChromaDB — open source, self-hosted, free forever ----
# Run locally with: docker run -p 8000:8000 chromadb/chroma
CHROMA_URL=http://localhost:8000

# ---- File uploads (resume) — Cloudinary free tier ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=



